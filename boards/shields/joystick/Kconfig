config SHIELD_JOYSTICK
    bool

config JOYSTICK
    bool "Enable joystick"
    select ANALOG_INPUT  # 如果勾选 JOYSTICK 自动开启 ANALOG_INPUT 驱动

menuconfig ANALOG_INPUT
    bool "ANALOG_INPUT adc sensor"
    select ADC
    select INPUT
    help
      Enable ANALOG_INPUT adc sensor.

if ANALOG_INPUT

config ANALOG_INPUT_USE_DTS_ADC_CH_CFG
    bool "Use per adc channel config from device tree"
    help
      Enable this to passthrow adc channel to chanel setup, 
      otherwise use default favor.
      (ADC_GAIN_1_6, ADC_REF_INTERNAL, ADC_ACQ_TIME_DEFAULT)

config ANALOG_INPUT_ADC_RES
    int "ADC Channels Resolution (Bit)"
    default 12
    help
      Resolution of ADC Channel. Default 12 bit, up to 32 bit.
      Used to setup buffer size of ADC sequencer of all channels.

config ANALOG_INPUT_WORKQUEUE_PRIORITY
    int "Workqueue priority"
    default 10
    help
      Priority of thread used by the workqueue.

config ANALOG_INPUT_WORKQUEUE_STACK_SIZE
    int "Workqueue stack size"
    default 1024
    help
      Stack size of thread used by the workqueue.

config ANALOG_INPUT_REPORT_INTERVAL_MIN
    int "ANALOG_INPUT's default minimum report rate"
    default 0
    help
      Default minimum report interval in milliseconds.
      Slow down input reporting for hid queue over the air.

config ANALOG_INPUT_LOG_DBG_RAW
    bool "ANALOG_INPUT debug log for RAW mV"

config ANALOG_INPUT_LOG_DBG_REPORT
    bool "ANALOG_INPUT debug log for REPORT value"

# 动态生成 CONFIG_ANALOG_INPUT_LOG_LEVEL
module = ANALOG_INPUT
module-str = analog_input
source "subsys/logging/Kconfig.template.log_config"

endif # ANALOG_INPUT
